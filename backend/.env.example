POSTGRES_USER=admin
POSTGRES_PASSWORD=secret
POSTGRES_DB=pet_classifier
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432

# auto prefers Apple MPS, then CUDA, then CPU. Use cpu to diagnose MPS issues.
AI_DEVICE=auto

# Lấy các thông tin này tại trang Dashboard của Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# Định dạng URL: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=cloudinary://your_api_key_here:your_api_secret_here@your_cloud_name_here
